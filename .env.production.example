# ChapMee production template — copy to VPS (never commit real secrets).
# Guide: docs/PRODUCTION_ENV_GUIDE.md
# Validate: npm run env:validate -- --file .env.production.example
# Generate secrets: openssl rand -base64 48  |  openssl rand -base64 32

# --- App URLs ---
NEXT_PUBLIC_APP_URL=https://chapmee.com
APP_URL=https://chapmee.com
NEXT_PUBLIC_SITE_URL=https://chapmee.com
NEXT_PUBLIC_APP_NAME=ChapMee

# --- Database (Docker service: postgres) ---
# POSTGRES_* must match DATABASE_URL and docker-compose postgrest PGRST_DB_URI.
POSTGRES_DB=chapmee
POSTGRES_USER=chapmee
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://chapmee:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/chapmee

# --- PostgREST legacy compatibility layer (required until Drizzle/API replaces all reads) ---
# Server: internal Docker network only. Browser: public HTTPS via Caddy /api/postgrest proxy.
POSTGREST_URL=http://postgrest:3000
NEXT_PUBLIC_POSTGREST_URL=https://chapmee.com/api/postgrest

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
BETTER_AUTH_URL=https://chapmee.com

# --- Redis (Docker service: redis) ---
REDIS_URL=redis://redis:6379
CHAPTER_CONTENT_CACHE_TTL_MS=900000

# --- S3-compatible storage (Vietnix Object Storage on production) ---
# Two buckets are used:
#   - S3_MEDIA_BUCKET: images (avatars, covers, chapter-media, composer, reel-bg).
#                      Public read — browser/CDN fetches directly.
#   - S3_TEXT_BUCKET:  text content (chapter body, standalone, reels text,
#                      community posts, comments). Private — server GET only.
# Same endpoint, same credentials, different buckets.
S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
S3_REGION=vn-hcm-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=CHANGE_ME_VIETNIX_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_VIETNIX_S3_SECRET

# Media (images) — public read.
S3_MEDIA_BUCKET=chapmee-media
# Custom domain `media.chapmee.com` is configured on Vietnix panel
# (CNAME / custom domain → bucket root). Bucket name is NOT in the URL.
S3_MEDIA_PUBLIC_BASE_URL=https://media.chapmee.com
# Client preview (no secrets) — same value as S3_MEDIA_PUBLIC_BASE_URL.
NEXT_PUBLIC_S3_MEDIA_PUBLIC_BASE_URL=https://media.chapmee.com

# Text — private, server-side GET only. No public base URL.
S3_TEXT_BUCKET=chapmee-text

# --- Server-only encryption (payment / provider secrets at rest) ---
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# --- Cron (/api/cron/*) ---
CRON_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# --- Transactional email (Postfix on VPS host — see docs/EMAIL_PRODUCTION_SETUP.md) ---
# web container reaches host Postfix via extra_hosts in docker-compose.production.yml
EMAIL_MODE=smtp
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ChapMee <no-reply@chapmee.com>
MAIL_REPLY_TO=ChapMee Support <support@chapmee.com>
EMAIL_MAX_RETRIES=3

# --- Optional: Cloudflare Turnstile ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: SePay (when enabling payments) ---
# SEPAY_API_KEY=
# SEPAY_WEBHOOK_SECRET=
# SEPAY_BANK_CODE=
# SEPAY_BANK_ACCOUNT_NUMBER=
# SEPAY_BANK_ACCOUNT_NAME=
# SEPAY_QR_BASE_URL=

# --- Dev / test helpers (leave empty in production) ---
RBAC_TEST_PASSWORD=
SEED_DEMO_PASSWORD=
CHAPMEE_SKIP_REMOTE_CONFIG=
CHAPMEE_POSTGREST_TIMEOUT_MS=

# --- PostgREST JWT (must match PGRST_JWT_SECRET in postgrest container) ---
POSTGREST_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# --- Optional: static PostgREST service JWT (app usually signs short-lived service_role JWT) ---
# POSTGREST_SERVICE_ROLE=
