# Public site URL used for canonical links and shareable metadata.
NEXT_PUBLIC_SITE_URL=

# Tên thương hiệu hiển thị (metadata, PWA). Mặc định: ChapMee.
NEXT_PUBLIC_APP_NAME=ChapMee

# Supabase project URL for browser/server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key for browser/server clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server/scripts only (RBAC test setup: npm run test:rbac:setup).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only key used to encrypt payment provider secrets stored in DB.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Password for test_*@chapchap.test accounts (optional).
RBAC_TEST_PASSWORD=

# Dev: set to 0 to load monetization_settings from Supabase on every cold start.
# Default in development is to use built-in defaults (faster when Supabase is slow/offline).
# Ưu tiên CHAPMEE_*; CHAPCHAP_* vẫn được đọc để tương thích deploy cũ.
CHAPMEE_SKIP_REMOTE_CONFIG=
CHAPCHAP_SKIP_REMOTE_CONFIG=

# PostgREST request timeout in ms (default 12000). Increase if Supabase is slow but reachable.
CHAPMEE_SUPABASE_TIMEOUT_MS=
CHAPCHAP_SUPABASE_TIMEOUT_MS=

# Optional: force runtime platform header fallback (web_desktop | web_mobile_pwa)
CHAPMEE_RUNTIME_PLATFORM=
CHAPCHAP_RUNTIME_PLATFORM=
