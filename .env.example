# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:4000
APP_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=ChapMee

# --- Official ChapMee social (footer short links /facebook, /tiktok, /youtube) ---
# Leave empty to show placeholder until channels are ready.
# CHAPMEE_FACEBOOK_URL=
# CHAPMEE_TIKTOK_URL=
# CHAPMEE_YOUTUBE_URL=

# --- Database ---
DATABASE_URL=postgresql://chapmee:chapmee_local_password@localhost:5432/chapmee_local

# PostgREST (legacy query compatibility layer)
POSTGREST_URL=http://127.0.0.1:54321
NEXT_PUBLIC_POSTGREST_URL=http://127.0.0.1:54321
# Must match PGRST_JWT_SECRET in docker-compose.local.yml (or use BETTER_AUTH_SECRET fallback in app)
POSTGREST_JWT_SECRET=chapmee_local_postgrest_jwt_secret_min_32_chars
# Optional static service JWT; if unset, app signs a short-lived service_role JWT locally
# POSTGREST_SERVICE_ROLE=

# --- Transactional email (queue + SMTP Postfix on VPS) ---
EMAIL_MODE=console
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
# Production VPS relay to host Postfix: SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ChapMee <no-reply@chapmee.com>
MAIL_REPLY_TO=ChapMee Support <support@chapmee.com>
EMAIL_MAX_RETRIES=3
# Optional: npm run email:test recipient
# EMAIL_TEST_TO=you@example.com

# --- Auth (Better Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
# Optional alias if your deploy pipeline standardizes on AUTH_SECRET
# AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:4000

# --- Google OAuth (Better Auth social login) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Application type: Web application
# Local redirect URI: http://localhost:4000/api/auth/callback/google
# Production redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Crawl protection (optional Turnstile challenge) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Redis (optional queues/cache) ---
REDIS_URL=redis://127.0.0.1:6379
# Chapter body cache TTL (ms), default 900000 (15 min). Key: chapter-content:{chapterId}:{contentHash}
CHAPTER_CONTENT_CACHE_TTL_MS=900000

# --- S3-compatible storage (MinIO local / Vietnix production) ---
# Two buckets are used:
#   - MEDIA bucket: images (avatars, covers, chapter-media, composer, reel-bg).
#                    Public read so browsers/CDN can fetch directly.
#   - TEXT bucket:  chapter body, standalone body, reels text, community posts,
#                    comments. Private — only the server fetches via secret keys.
#
# Chapter text bodies use story-content/... keys via lib/storage/chapter-content-storage.ts
# (not media_assets — that registry is for images/media only).

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=chapmee_minio
S3_SECRET_ACCESS_KEY=chapmee_minio_password

# Media (images) bucket — public read.
# URL is served via custom domain (Vietnix panel configures `media.chapmee.com` CNAME to bucket).
# NO bucket name in the path — short, clean URLs.
S3_MEDIA_BUCKET=chapmee-local-media
S3_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/chapmee-local-media
# Mirror for client preview (no secrets) — same value as S3_MEDIA_PUBLIC_BASE_URL
NEXT_PUBLIC_S3_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/chapmee-local-media

# Text bucket — private, server-side GET only. No public base URL.
S3_TEXT_BUCKET=chapmee-local-text

# Xác minh (KYC) bucket — private, no public read, no ACL public-read.
# Only accessed via short-lived signed URLs through authenticated API.
S3_XACMINH_BUCKET=chapmee-local-xacminh

# --- Legacy single-bucket env (still read as fallback) ---
# If S3_MEDIA_BUCKET is unset, code falls back to S3_BUCKET for backward compat.
# S3_BUCKET=chapmee-local-media
# S3_PUBLIC_BASE_URL=http://localhost:9000/chapmee-local-media
# NEXT_PUBLIC_S3_PUBLIC_BASE_URL=http://localhost:9000/chapmee-local-media

# --- Production examples (do not commit real secrets) ---
# NEXT_PUBLIC_APP_URL=https://chapmee.com
# APP_URL=https://chapmee.com
# DATABASE_URL=postgresql://chapmee:STRONG_PASSWORD@postgres:5432/chapmee
# BETTER_AUTH_URL=https://chapmee.com
# S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
# S3_REGION=vn-hcm-1
# S3_MEDIA_BUCKET=chapmee-media
# S3_MEDIA_PUBLIC_BASE_URL=https://media.chapmee.com
# NEXT_PUBLIC_S3_MEDIA_PUBLIC_BASE_URL=https://media.chapmee.com
# S3_TEXT_BUCKET=chapmee-text
# S3_FORCE_PATH_STYLE=true

# Server-only encryption for payment provider secrets (unrelated to infra MVP)
ENCRYPTION_KEY=

# Dev / test helpers
SEED_DEMO_PASSWORD=
RBAC_TEST_PASSWORD=
CHAPMEE_SKIP_REMOTE_CONFIG=
CHAPMEE_POSTGREST_TIMEOUT_MS=
# Instant kill switch for admin custom snippets on the public frontend
# CHAPMEE_DISABLE_SNIPPETS=true
