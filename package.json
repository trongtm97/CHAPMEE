{
  "name": "chapchap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "node scripts/clean-next-cache.mjs && next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:turbo:clean": "node scripts/clean-next-cache.mjs && next dev --turbopack",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rbac:setup": "npx --yes tsx scripts/rbac-setup-test-users.ts",
    "test:rbac": "npx --yes tsx scripts/rbac-run-matrix.ts",
    "test:read-listen-bridge": "npx --yes tsx scripts/validate-read-listen-bridge.ts",
    "test:seo": "node scripts/seo-slug-self-test.mjs",
    "test:topup": "node scripts/topup-package-self-test.mjs",
    "taxonomy:seed-sql": "npx --yes tsx scripts/generate-taxonomy-seed-sql.ts",
    "taxonomy:verify-slugs": "npx --yes tsx scripts/verify-taxonomy-subgenre-slugs.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate-foundation.mjs",
    "db:migrate:status": "node scripts/db-migrate-foundation.mjs --status",
    "db:shims": "node scripts/db-apply-shims.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:legacy": "node scripts/db-apply-legacy-migrations.mjs",
    "db:legacy:only": "node scripts/db-apply-legacy-only.mjs",
    "db:legacy:status": "node scripts/db-apply-legacy-migrations.mjs --status",
    "db:legacy:stamp": "node scripts/db-apply-legacy-migrations.mjs --stamp-baseline",
    "db:setup": "npm run db:migrate && npm run db:legacy && npm run db:shims",
    "db:seed": "npx --yes tsx scripts/db-seed-local.ts",
    "db:seed:rbac": "npm run db:seed -- --with-rbac",
    "db:reset-local": "node scripts/db-reset-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "docker:local:up": "docker compose --env-file .env.local -f docker-compose.local.yml up -d",
    "docker:local:recreate:postgrest": "docker compose --env-file .env.local -f docker-compose.local.yml up -d --force-recreate postgrest",
    "db:repair-auth-users": "node scripts/repair-orphan-auth-user.mjs",
    "profiles:backfill-usernames": "npx --yes tsx scripts/backfill-profile-usernames.ts",
    "content-origin:backfill": "npx --yes tsx scripts/backfill-content-origin.ts",
    "community-sync:backfill-story-groups": "npx --yes tsx scripts/backfill-story-groups.ts",
    "community-sync:rebuild-feed": "npx --yes tsx scripts/rebuild-group-feed-projection.ts",
    "community-sync:validate": "npx --yes tsx scripts/validate-story-community-sync.ts",
    "story-sync:backfill:dry-run": "npm run community-sync:backfill-story-groups",
    "story-sync:backfill": "npm run community-sync:backfill-story-groups -- --apply",
    "story-sync:rebuild-feed:dry-run": "npm run community-sync:rebuild-feed",
    "story-sync:rebuild-feed": "npm run community-sync:rebuild-feed -- --apply",
    "content-origin:validate": "npx --yes tsx scripts/validate-content-origin-policy.ts",
    "media:check": "npx --yes tsx scripts/check-media-integrity.ts",
    "media:refs:audit": "npx --yes tsx scripts/audit-media-storage-refs.ts --strict",
    "media:refs:migrate": "npx --yes tsx scripts/migrate-hardcoded-media-urls.ts --dry-run",
    "media:manifest": "npx --yes tsx scripts/export-media-manifest.ts",
    "test:chapter-content": "npx --yes tsx scripts/test-chapter-content-storage.ts",
    "backfill:chapter-content": "npx --yes tsx scripts/backfill-chapter-content-s3.ts",
    "import:local-file": "npx --yes tsx scripts/import-local-file.ts",
    "import:cleanup": "npx --yes tsx scripts/cleanup-import-artifacts.ts",
    "storage:check-chapters": "npx --yes tsx scripts/check-chapter-content-integrity.ts",
    "storage:check-imports": "npx --yes tsx scripts/check-import-storage-integrity.ts",
    "storage:cleanup-import-temp": "npx --yes tsx scripts/cleanup-import-temp.ts",
    "storage:cleanup-orphan-chapters": "npx --yes tsx scripts/cleanup-orphan-chapter-content.ts",
    "storage:health": "npx --yes tsx scripts/storage-health.ts",
    "storage:init": "npx --yes tsx scripts/init-storage.ts",
    "storage:check": "npx --yes tsx scripts/check-storage.ts",
    "backup:postgres": "bash scripts/deploy/backup-postgres.sh",
    "backup:minio": "bash scripts/deploy/backup-minio.sh",
    "backup:all": "bash scripts/deploy/backup-all.sh",
    "storage:check-all": "npx --yes tsx scripts/run-storage-checks.ts",
    "storage:check-s3-orphans": "npx --yes tsx scripts/check-s3-orphan-chapter-keys.ts",
    "storage:scheduled-dry-run": "npx --yes tsx scripts/storage-scheduled-dry-run.ts",
    "audio:check-links": "npx --yes tsx scripts/check-audio-links.ts",
    "audio:validate": "npx --yes tsx scripts/validate-audio-companion.ts",
    "encoding:check": "npx --yes tsx scripts/check-encoding.ts",
    "encoding:check:strict": "npx --yes tsx scripts/check-encoding.ts --strict",
    "db:encoding": "npx --yes tsx scripts/check-db-encoding.ts",
    "mojibake:scan:db": "npx --yes tsx scripts/scan-mojibake-db.ts",
    "mojibake:repair:db": "npx --yes tsx scripts/repair-mojibake-db.ts",
    "mojibake:scan:files": "npx --yes tsx scripts/scan-mojibake-files.ts",
    "env:validate": "npx --yes tsx scripts/validate-env.ts",
    "email:worker": "npx --yes tsx scripts/email-worker.ts",
    "email:test": "npx --yes tsx scripts/test-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@better-auth/utils": "0.4.1",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-horizontal-rule": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-table": "^3.26.1",
    "@tiptap/extension-table-cell": "^3.26.1",
    "@tiptap/extension-table-header": "^3.26.1",
    "@tiptap/extension-table-row": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "better-auth": "^1.2.5",
    "drizzle-orm": "^0.43.1",
    "fflate": "^0.8.3",
    "kysely": "^0.28.7",
    "next": "^16.2.6",
    "nodemailer": "^7.0.3",
    "pg": "^8.14.1",
    "playwright": "^1.49.0",
    "react": "latest",
    "react-dom": "latest",
    "react-easy-crop": "^5.5.7",
    "redis": "^4.7.1",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "drizzle-kit": "^0.31.0",
    "eslint": "latest",
    "eslint-config-next": "^16.2.6",
    "postcss": "latest",
    "prettier": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  }
}
